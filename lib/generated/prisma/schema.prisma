// WHIPLY — schema. See blueprint §10.
// Money is ALWAYS integer cents (Int). Timestamps are timestamptz in UTC.
// Invariants that must never be violated are CHECK constraints in the
// migration, not application logic — see prisma/migrations/*/constraints.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum ProductCategory {
  CREAM_CHARGERS
  BAKING_EQUIPMENT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_DELIVERY
  DELIVERY_BOOKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  REVIEW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum DeliveryStatus {
  NOT_BOOKED
  BOOKING
  DRIVER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

enum DeliveryProvider {
  LALAMOVE
  MANUAL
}

enum DiscountValueType {
  PERCENT
  FIXED
}

// Simplified by instruction: a code is limited by TIME or by USES. Nothing else.
enum DiscountLimitType {
  TIME_LIMITED
  USE_LIMITED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
  SPAM
}

enum AdminRole {
  OWNER
  STAFF
}

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  sku         String          @unique
  slug        String          @unique
  name        String
  category    ProductCategory
  shortDesc   String          @map("short_desc")
  cardLabel   String?         @map("card_label")
  description String
  specs       Json            @default("[]")
  priceCents  Int             @map("price_cents")
  imageUrl    String?         @map("image_url")
  imageAlt    String?         @map("image_alt")
  stockQty    Int             @map("stock_qty")
  lowStockAt  Int             @default(10) @map("low_stock_at")
  isActive    Boolean         @default(true) @map("is_active")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItems OrderItem[]

  @@index([category, isActive])
  @@map("products")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  reference        String      @unique
  orderStatus      OrderStatus @default(PENDING_PAYMENT) @map("order_status")
  subtotalCents    Int         @map("subtotal_cents")
  discountCents    Int         @default(0) @map("discount_cents")
  deliveryFeeCents Int         @map("delivery_fee_cents")
  totalCents       Int         @map("total_cents")

  // No customer entity by design (§9.9). Contact and address are snapshots.
  contactName  String  @map("contact_name")
  contactEmail String  @map("contact_email")
  contactPhone String  @map("contact_phone")
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  postalCode   String  @map("postal_code")
  instructions String? @db.VarChar(280)

  // Normalised copies used only by the derived "customers" view (§9.9).
  normalisedEmail String @map("normalised_email")
  normalisedPhone String @map("normalised_phone")

  discountCodeId String?       @map("discount_code_id") @db.Uuid
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  reviewReason String?   @map("review_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  paidAt       DateTime? @map("paid_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)

  items      OrderItem[]
  payment    Payment?
  delivery   Delivery?
  redemption DiscountRedemption?
  events     OrderEvent[]

  @@index([orderStatus, createdAt(sort: Desc)])
  @@index([normalisedEmail])
  @@index([normalisedPhone])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Snapshot: what the customer actually bought, at the price they paid.
  skuAtPurchase   String  @map("sku_at_purchase")
  nameAtPurchase  String  @map("name_at_purchase")
  imageAtPurchase String? @map("image_at_purchase")
  unitPriceCents  Int     @map("unit_price_cents")
  quantity        Int
  lineTotalCents  Int     @map("line_total_cents")

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @unique @map("order_id") @db.Uuid
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String        @default("hitpay")
  requestId     String        @unique @map("request_id")
  paymentId     String?       @unique @map("payment_id")
  amountCents   Int           @map("amount_cents")
  currency      String        @default("SGD") @db.Char(3)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  method        String?
  checkoutUrl   String?       @map("checkout_url")
  refundedCents Int           @default(0) @map("refunded_cents")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(6)
  refundedAt    DateTime?     @map("refunded_at") @db.Timestamptz(6)

  @@map("payments")
}

model Delivery {
  id                 String           @id @default(uuid()) @db.Uuid
  orderId            String           @unique @map("order_id") @db.Uuid
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           DeliveryProvider @default(LALAMOVE)
  providerRef        String?          @map("provider_ref")
  quotationId        String?          @map("quotation_id")
  estimatedCostCents Int?             @map("estimated_cost_cents")
  actualCostCents    Int?             @map("actual_cost_cents")
  deliveryStatus     DeliveryStatus   @default(NOT_BOOKED) @map("delivery_status")
  driver             Json?
  trackingUrl        String?          @map("tracking_url")
  failureReason      String?          @map("failure_reason")
  attempts           Int              @default(0)
  nextAttemptAt      DateTime?        @map("next_attempt_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookedAt           DateTime?        @map("booked_at") @db.Timestamptz(6)
  deliveredAt        DateTime?        @map("delivered_at") @db.Timestamptz(6)

  @@index([deliveryStatus])
  @@map("deliveries")
}

model DiscountCode {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique
  valueType        DiscountValueType @map("value_type")
  percentOff       Int?              @map("percent_off")
  valueCents       Int?              @map("value_cents")
  limitType        DiscountLimitType @map("limit_type")
  startsAt         DateTime?         @map("starts_at") @db.Timestamptz(6)
  expiresAt        DateTime?         @map("expires_at") @db.Timestamptz(6)
  maxUses          Int?              @map("max_uses")
  usesCount        Int               @default(0) @map("uses_count")
  attributionLabel String?           @map("attribution_label")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders      Order[]
  redemptions DiscountRedemption[]

  @@map("discount_codes")
}

model DiscountRedemption {
  id              String       @id @default(uuid()) @db.Uuid
  codeId          String       @map("code_id") @db.Uuid
  code            DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  orderId         String       @unique @map("order_id") @db.Uuid
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountCents   Int          @map("discount_cents")
  orderTotalCents Int          @map("order_total_cents")
  redeemedAt      DateTime     @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  @@index([codeId])
  @@map("discount_redemptions")
}

model Enquiry {
  id         String        @id @default(uuid()) @db.Uuid
  name       String
  phone      String
  email      String
  message    String?       @db.VarChar(1000)
  status     EnquiryStatus @default(NEW)
  notes      String?
  sourcePage String?       @map("source_page")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@map("enquiries")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("settings")
}

model WebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  provider      String
  eventId       String   @map("event_id")
  payloadDigest String   @map("payload_digest")
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

model OrderEvent {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  detail     Json     @default("{}")
  actor      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  totpSecret   String?   @map("totp_secret")
  totpEnrolled Boolean   @default(false) @map("totp_enrolled")
  role         AdminRole @default(OWNER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  auditEntries AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id         String     @id @default(uuid()) @db.Uuid
  actorId    String?    @map("actor_id") @db.Uuid
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String     @map("actor_label")
  entity     String
  entityId   String?    @map("entity_id")
  action     String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}
