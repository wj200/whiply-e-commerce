# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=""
DIRECT_DATABASE_URL=""
NEXT_PUBLIC_SITE_URL=""
AUTH_SECRET=""
CRON_SECRET=""

# ── Stripe (PayNow only) ─────────────────────────────────────────────
# No publishable key: the PaymentIntent is created and confirmed server-side
# and the customer goes to Stripe's hosted PayNow QR page, so nothing runs in
# the browser that would need one.
STRIPE_API_BASE="https://api.stripe.com"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Resend (customer receipts) ───────────────────────────────────────
# Both are REQUIRED in production: without them a paid order sends no invoice
# and the deploy would otherwise report success.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="WHIPLY <orders@yourdomain.sg>"
OPERATOR_ALERT_EMAIL=""

# ── WhatsApp Cloud API (business order alert) ────────────────────────
# WHATSAPP_BUSINESS_NUMBER is the shop's OWN number, in E.164 — it is the
# recipient of the alert, not the sender.
WHATSAPP_API_BASE="https://graph.facebook.com/v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_NUMBER="+65XXXXXXXX"
# The Meta-approved template. Set to "" ONLY in local development to send
# free-form text instead; in production free-form messages are accepted by
# the API and then silently not delivered.
WHATSAPP_TEMPLATE_NAME="whiply_order_alert"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# ── Cloudflare Turnstile (bulk enquiry form) ─────────────────────────
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Optional ─────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
SENTRY_DSN=""
